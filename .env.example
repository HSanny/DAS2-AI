# DAS2-AI configuration
# ===========================================================================
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#     cp .env.example .env
#
# Every setting here maps to a field in das2/config.py by the rule
# DAS2_<SECTION>_<FIELD>, so anything in that file can be overridden the same
# way even if it is not listed here.


# ---------------------------------------------------------------------------
# 1. THE HISTORIAN'S SHARE  (required)
# ---------------------------------------------------------------------------
# HISTORY and HISTCURR are mounted straight off \\<host>\dds_share over CIFS,
# read-only. The Docker DAEMON does the mounting, so the HOST needs
# `cifs-utils` installed (apt install cifs-utils); the container needs nothing.
#
# These are the same three names the previous deployment used, so existing
# values carry over unchanged.
DAS_VM_USERNAME=
DAS_VM_PASSWORD=

# The machine serving dds_share. Usually the same box as SQL Server, which is
# why it is named this way; point it elsewhere if the share lives apart.
DAS_MSSQL_HOST=

# HISTALMEVT is deliberately not mounted -- SCADA alarms are out of scope and
# nothing reads them. See the volumes block in docker-compose.yml.


# ---------------------------------------------------------------------------
# 1b. LongLat.csv  (required for the map)
# ---------------------------------------------------------------------------
# NOT on the share -- it is a one-off export rather than an hourly one -- so it
# comes from a local folder mounted read-only at /data/config.
#
#     mkdir -p ./config && cp /path/to/LongLat.csv ./config/
#
# Without it the system still runs and still finds faults, but there is no map,
# no geo-clustering and no "by region" view -- which is most of what it was
# built for. `das2-check` reports it as a FAIL rather than letting it pass
# quietly.
DAS2_CONFIG_DIR=./config

# Where dashboards, PNGs and logs are written on the host. These must be
# WRITABLE, unlike everything above.
DAS2_OUTPUT_DIR=./output
DAS2_LOG_DIR=./logs


# ---------------------------------------------------------------------------
# 2. DATABASE  (required)
# ---------------------------------------------------------------------------
# Either give a full SQLAlchemy URL...
#
#   SQL Server:
#     DAS2_DATABASE_URL=mssql+pyodbc://user:pass@host:1433/DAS2?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#   SQLite, to try it without a server:
#     DAS2_DATABASE_URL=sqlite:////data/output/das2.db
#
# The `?driver=...&TrustServerCertificate=yes` part is appended for you if you
# leave it off, because omitting it fails at CONNECT time with an error naming
# neither this setting nor this file:
#   IM002 [unixODBC][Driver Manager] Data source name not found and no
#   default driver specified
# A driver you DO name is never overridden.
#
# If the password contains @ : / ? # or %, percent-escape it (@ -> %40,
# : -> %3A, % -> %25) or the URL will not parse. The split fields below need
# no escaping, so they are the easier route for an awkward password.
#
DAS2_DATABASE_URL=

# ...or leave URL empty and give the parts. The URL wins if both are set.
DAS2_DATABASE_HOST=
DAS2_DATABASE_PORT=1433
DAS2_DATABASE_DATABASE=
DAS2_DATABASE_USERNAME=
DAS2_DATABASE_PASSWORD=
# The Dockerfile installs driver 18. Change only if you install a different one.
DAS2_DATABASE_DRIVER=ODBC Driver 18 for SQL Server


# ---------------------------------------------------------------------------
# 3. TELEGRAM  (required for alerting)
# ---------------------------------------------------------------------------
# Token from @BotFather. Chat id from @userinfobot, or for a group, add the bot
# to the group and read the id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# after posting a message there. A GROUP chat id is negative, e.g. -1001234567890.
DAS2_ALERT_TELEGRAM_TOKEN=
DAS2_ALERT_TELEGRAM_CHAT_ID=

# Set false to run fully silent while you evaluate the output.
DAS2_ALERT_ENABLED=true

# Hard cap on messages per run, so one bad run cannot flood the chat.
# Anything beyond it is summarised in a line and stays on the dashboard.
DAS2_ALERT_MAX_INCIDENTS_PER_RUN=10

# If you serve the dashboard folder over HTTP, put the base URL here and every
# alert gets a link to the full page.
DAS2_ALERT_DASHBOARD_BASE_URL=


# ---------------------------------------------------------------------------
# 4. CADENCE AND WINDOW
# ---------------------------------------------------------------------------
# How often to analyse. Nothing in the code assumes a cadence -- every window
# and threshold is expressed in time, not in runs or samples -- so this is
# genuinely free to change.
DAS2_RUN_INTERVAL_MINUTES=60

# How much history each run looks at. Longer sees slower faults but re-reports
# an old one for longer; the incident layer is what stops that becoming
# repeated alerts.
DAS2_INGEST_WINDOW_HOURS=72


# ---------------------------------------------------------------------------
# 4b. READING HISTORY  (what the daily profile job learns from)
# ---------------------------------------------------------------------------
# Persist every run's readings into das2_reading. This is what gives the daily
# job its history, and therefore what makes DRIFT, NOISE_BURST and the
# time-of-day baselines possible at all. Turn it off only if your v1 `data`
# table is already readable by this login and is being retained.
DAS2_DATABASE_STORE_READINGS=true

# Months x 2,672 sensors x 120 s is on the order of 10^8 rows, so the table
# cannot grow without bound. 60 days is comfortably more than the 28 the
# profile job wants.
DAS2_DATABASE_READING_RETENTION_DAYS=60

# Optional: an EXISTING table the daily profile job may learn history from
# while das2_reading fills up. Must expose sensor_key, ts and value by those
# names (a view is fine). Left empty the system starts from scratch, which
# means DRIFT, NOISE_BURST and the baseline layer produce nothing for the first
# few weeks -- and say so rather than failing silently.
DAS2_DATABASE_HISTORY_FALLBACK_TABLE=


# ---------------------------------------------------------------------------
# 5. TUNING  (sensible defaults; change once you have seen real output)
# ---------------------------------------------------------------------------
# How far apart two sites may be and still count as one event. 5 km was
# measured from the real LongLat.csv, not guessed: PUB sites have a median
# nearest neighbour of 1.0 km, and a genuine East-side event spans 3.3-4.4 km,
# which a 2 km or 3 km radius would fail to link at all.
DAS2_SPATIAL_CLUSTER_RADIUS_M=5000

# A cluster wider than this is split -- it is no longer one crew's job.
DAS2_SPATIAL_MAX_CLUSTER_DIAMETER_M=5000

# Sensors whose anomaly windows are within this are treated as simultaneous.
DAS2_SPATIAL_TIME_OVERLAP_TOLERANCE_MIN=30

# Close an incident once nothing has been seen for this long.
DAS2_INCIDENT_RESOLVE_AFTER_MIN=720

# Rain context, from your own ~188 *-Rainfall sensors. No external API and no
# internet needed; this is a matter of not discarding data you already collect.
DAS2_RAIN_ENABLED=true
DAS2_RAIN_EXPLAINS_MM=5

# How far to look for neighbouring sensors when asking "did the neighbours move
# too?" -- the signal that separates "the water moved" from "the instrument is
# lying". Wider than the cluster radius on purpose: the question needs context
# from OUTSIDE the cluster.
DAS2_SPATIAL_CORRELATION_RADIUS_M=5000

# Per-region alert budget per run. Replaces v1's global top-10 rank cut, under
# which a bad night in the West could silently crowd out the East's one real
# problem. P1 incidents bypass it entirely.
DAS2_ALERT_MAX_ALERTS_PER_REGION=5


# ---------------------------------------------------------------------------
# 6. LOGGING
# ---------------------------------------------------------------------------
# DEBUG is very verbose. Useful for the first few runs, not for a month of them.
DAS2_LOG_LEVEL=INFO
