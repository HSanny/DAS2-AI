# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Runtime output -- regenerated every run, never source of truth
logs/
raw/
output_csv/
output_plots/
output_html/
cache/

# Local environment / secrets
.env
*.local.yaml

# Test scratch
tests/.tmp_*

# Fujitsu inputs mounted at runtime, not committed
HISTORY/
HISTALMEVT/
HISTCURR/

# Client credentials must never be committed
deploy/.env
deploy/notes.txt
**/notes.txt

# Deployment artefacts holding real credentials or real data.
#
# ROOT-ANCHORED on purpose. Written as `data/`, the pattern matched EVERY
# directory called data, which quietly included `das2/data/` -- the package's
# own config. `event_signatures.yaml` is meant to be edited by a PUB engineer
# and is useless if git will not track it, and the rules file next to it was
# only in the repo because it had been force-added.
/output/
/data/
*.db
*.sqlite
docker-compose.override.yml
